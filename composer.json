{
    "name": "historyheraldry/ci4-seed-tracker",
    "description": "Migration-style tracked database seeds for CodeIgniter 4.",
    "keywords": [
        "codeigniter4",
        "database",
        "migrations",
        "seeds"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "HistoryHeraldry\\SeedTracker\\": "src/"
        },
        "exclude-from-classmap": [
            "src/Database/Migrations/**"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit",
        "quality": [
            "@composer validate --strict",
            "@analyse",
            "@test"
        ]
    }
}
